# Sanfuclaw Configuration
# Copy this file to sanfuclaw.toml and fill in your values.
# API keys can also be set via environment variables (LLM_API_KEY, TELEGRAM_BOT_TOKEN)

timezone = "Asia/Shanghai"          # cron scheduling timezone

[llm]
provider = "openai_compat"          # or "anthropic"
model = "zai-org/glm-5.1"
base_url = "https://api.hpc-ai.com/inference/v1"
api_key = ""                        # Your LLM API key
max_tokens = 200000
max_tool_rounds = 10
temperature = 0.7
system_prompt = "You are a helpful personal AI assistant called Sanfuclaw. You are running locally on the user's machine. Be concise and helpful."

[gateway]
host = "127.0.0.1"
port = 30423

# Channel configurations
# Uncomment and set bot_token to enable Telegram
# [channels.telegram]
# type = "telegram"
# bot_token = ""
# allowed_users = []  # Empty = allow all, or list of usernames/IDs

# [channels.discord]
# type = "discord"
# bot_token = ""

# Skills — markdown files with frontmatter, discovered on startup.
# The LLM sees a `name: description` summary and calls `load_skill`
# lazily when a request matches.
[skills]
dir = "./skills"

# MCP (Model Context Protocol) servers.
# Install the extra first:  pip install -e ".[mcp]"
# Each server is either spawned over stdio (command/args/env) or
# reached over SSE (url). Tools get registered as `mcp_<server>_<tool>`
# and are called by the LLM exactly like built-in tools.
#
# ⚠ Every enabled server adds its tool schemas to the LLM request on
#   *every* turn — filesystem alone is ~2.5k input tokens, all five
#   recommended servers together are ~5k tokens/turn. Prompt caching
#   (enabled by default for Anthropic) drops repeat turns to ~10% of
#   that. Still: enable only what you need for a given session.
#
# Zero-auth official reference servers — uncomment any you want.

# Sandboxed filesystem access (reads/writes under the given directory)
# [mcp.servers.filesystem]
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]

# Structured git operations (log, diff, blame, show) — needs `uv` installed
# [mcp.servers.git]
# command = "uvx"
# args = ["mcp-server-git", "--repository", "."]

# Timezone-aware current time — fixes "what's today's date" confusion
# [mcp.servers.time]
# command = "uvx"
# args = ["mcp-server-time"]

# Structured step-by-step reasoning tool
# [mcp.servers.sequential-thinking]
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-sequential-thinking"]

# URL fetcher with robots.txt handling + markdown conversion
# [mcp.servers.fetch]
# command = "uvx"
# args = ["mcp-server-fetch"]

# Servers that need an API key or token — pass secrets via `env`:
# [mcp.servers.github]
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-github"]
# env = { GITHUB_PERSONAL_ACCESS_TOKEN = "ghp_xxx" }

# Remote MCP server over SSE:
# [mcp.servers.remote]
# url = "https://mcp.example.com/sse"

# Any server can be temporarily disabled without removing its config:
# [mcp.servers.some-name]
# enabled = false
# command = "..."
